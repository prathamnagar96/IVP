# JobRadar API Environment Variables
# Copy this file to .env and fill in your values

# Database (Supabase)
# Get these from your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# API Authentication
# RapidAPI proxy secret (from RapidAPI provider dashboard)
RAPIDAPI_PROXY_SECRET=your-rapidapi-proxy-secret

# Comma-separated list of valid API keys for direct access
API_KEYS=your-api-key-1,your-api-key-2

# Alerting (optional)
# Discord/Slack webhook URL for run summaries
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Sync Configuration
ATS_SYNC_INTERVAL_HOURS=6
SCRAPE_SYNC_INTERVAL_HOURS=24
EXPIRY_DAYS=30

# Scraper
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT=30000
SCRAPER_USER_AGENT="JobRadar/1.0 (+https://jobradar.example.com/bot)"

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json